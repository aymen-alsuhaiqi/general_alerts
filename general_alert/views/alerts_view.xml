<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View general.alerts View tree -->
    <record id="view_general_alerts_tree" model="ir.ui.view">
        <field name="name">view.general.alerts.tree</field>
        <field name="model">general.alerts</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="alert_title"/>
                <field name="alert_status" />
                <field name="alert_const" />
                <field name="alert_type" />
            </tree>
        </field>
    </record>

    <!-- View general.alerts form -->
    <record id="view_general_alerts_form" model="ir.ui.view">
        <field name="name">view.general.alerts.form</field>
        <field name="model">general.alerts</field>
        <field name="arch" type="xml">
            <form string="Alerts Alerts">
                <sheet>
                    <div class="oe_title">
                        <label for="alert_title"/>
                        <h1>
                            <field name="alert_title"/>
                        </h1>
                        <label for="alert"/>
                        <h2>
                            <field name="alert" placeholder="Write alert message here...."/>
                        </h2>
                        <group>
                        <group>
                        <field name="alert_status" />
                        </group>
                        <group>
                        <field name="alert_const" />
                        </group>
                        <group>
                        <field name="alert_type" />
                        </group>
                        <group>
                        <field name="until_date" />
                        </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="alert_view_search" model="ir.ui.view">
        <field name="name">alert.view.search</field>
        <field name="model">general.alerts</field>
        <field name="arch" type="xml">
            <search string="">
                <filter name="active_alert" string="active alert" domain="[('until_date', '&gt;=', context_today()),('alert_status','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- Action general.alerts -->
    <record id="action_general_alerts" model="ir.actions.act_window">
        <field name="name">General Alerts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">general.alerts</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Alerts Alerts.
            </p>
        </field>
        <field name="context">{'search_default_active_alert':1}</field>
    </record>

    <menuitem id="alert_menu" name="Alerts" sequence="103">

    <menuitem id="message_alert_menu" name="messages" groups="general_alert_manager_group" action="action_general_alerts" sequence="1"/>
    </menuitem>


</odoo>
